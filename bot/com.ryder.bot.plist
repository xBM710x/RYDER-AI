<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- RYDER auto-start for Mac. install_mac.sh fills in RYDER_DIR and copies this to ~/Library/LaunchAgents. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ryder.bot</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>RYDER_DIR/start.sh</string></array>
  <key>WorkingDirectory</key><string>RYDER_DIR</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>RYDER_DIR/launchd.log</string>
  <key>StandardErrorPath</key><string>RYDER_DIR/launchd.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/Library/Frameworks/Python.framework/Versions/Current/bin:/usr/bin:/bin</string></dict>
</dict></plist>
